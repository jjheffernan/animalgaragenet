{
	"name": "animalgaragenet",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check:secrets": "bash scripts/check-secrets.sh",
		"check:secrets:bundle": "CHECK_CLIENT_BUNDLE=1 bash scripts/check-secrets.sh",
		"secrets:audit": "bash scripts/check-github-secrets.sh",
		"secrets:push": "bash scripts/push-github-secrets.sh",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "svelte-kit sync && vitest run",
		"test:readiness": "sh -c 'if [ -f .env ]; then tsx --env-file=.env scripts/test-readiness.ts; else tsx scripts/test-readiness.ts; fi'",
		"test:contracts": "vitest run tests/contracts",
		"test:e2e": "playwright test",
		"test:ci": "npm run test:unit && CI=true npm run test:e2e"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-auto": "^9.0.0",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24",
		"@types/sanitize-html": "^2.16.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.11.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@aws-sdk/client-cloudfront": "^3.1076.0",
		"@aws-sdk/client-s3": "^3.1079.0",
		"@aws-sdk/s3-request-presigner": "^3.1079.0",
		"@stripe/stripe-js": "^9.8.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.110.0",
		"sanitize-html": "^2.18.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
